# Claude AI (for email personalization)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
RESEARCH_MODEL=claude-opus-4-5

# Apollo.io
APOLLO_API_KEY=

# Hunter.io
HUNTER_API_KEY=

# Email provider: zoho | gmail | outlook (default: gmail)
# Can also be set per-run with --provider flag: node run.js companies.csv --provider gmail
EMAIL_PROVIDER=gmail

# ── Zoho Mail (populated by setup-zoho-auth.js) ──────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# ── Gmail (populated by setup-gmail-auth.js) ─────────────────────────────────
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below
GMAIL_REFRESH_TOKEN=

# ── Outlook / Microsoft 365 (populated by setup-outlook-auth.js) ─────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=

# Sender identity
SENDER_NAME=Akhil
SENDER_EMAIL=you@yourdomain.com

# Attachments: comma-separated file paths to attach to every email (optional)
# ATTACHMENT_PATHS=assets/brochure.pdf,assets/one-pager.pdf

# Template and prompt paths (relative to project root)
TEMPLATE_PATH=templates/template.txt
PROMPT_PATH=templates/prompt.txt
USER_PROMPT_PATH=templates/user_prompt.txt

# Voice DNA config (generated by setup-voice-profile.js — optional but strongly recommended)
# Primary: config/voice-dna.md (structured format)
# Fallback: templates/voice-profile.md (legacy)
VOICE_DNA_PATH=config/voice-dna.md
SYSTEM_PROMPT_PATH=config/system-prompt.md

# Google OAuth credentials (shared between Gmail sending and voice profile setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting: seconds between sends (0–300, default 30)
SEND_DELAY_SECONDS=30
